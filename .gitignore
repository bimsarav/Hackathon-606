.idea/*
# Product build output and local secrets (each product repo also has its own .gitignore)
.env
products/**/target/
products/**/node_modules/
products/**/dist/
products/**/build/
products/**/test-results/
products/**/playwright-report/
products/**/.env
# Archived logs of finished product runs are local only; the live (unfinished-run) logs ARE committed
execution/archive/

# Cloud environment details may arrive in a folder under input/ (user 2026-11-20).
# Never commit credentials from it; non-secret descriptions (provider, region, domain) stay tracked.
input/**/.env*
input/**/*.pem
input/**/*.key
input/**/*.p12
input/**/*.pfx
input/**/*.jks
input/**/*.ppk
input/**/id_rsa*
input/**/id_ed25519*
input/**/*kubeconfig*
input/**/*.kubeconfig
input/**/*credential*
input/**/*secret*
input/**/*token*
input/**/*password*
input/**/*.tfvars
input/**/*.tfstate*
input/**/service-account*.json
input/**/*sa-key*.json
# Any file in input/cloud-environment/ except Markdown notes (e.g. SSH keys named after a host)
input/cloud-environment/*
!input/cloud-environment/*.md
# Inbox data files (user 2026-11-20): bookings contain passenger names (PII) and are ~1 GB. Keep the README only.
input/inbox/*
!input/inbox/README.md
# Disruption-management (UC5) datasets: treated as real passenger data (user 2026-11-20), ~1 GB. Never commit.
input/data/disruption-uc5/Past & Future Booking Data.zip
input/data/disruption-uc5/parquet/raw/bookings/*
# Secrets supplied by the user (e.g. AI_API_KEY, user 2026-11-20). Never commit, print or log.
input/secrets/

# Runtime settings with secrets (API keys) - never commit (2026-11-21)
products/**/settings.env

# Copy to .env for local use. Never commit .env. Production values come from the secret store.
POSTGRES_DB=sample_app
POSTGRES_USER=sample_app
POSTGRES_PASSWORD=change-me-local-only
DJANGO_SECRET_KEY=change-me-local-only-use-50-random-characters-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Local compose runs over plain HTTP. Keep true (the default) behind TLS.
DJANGO_SECURE_COOKIES=false
LOG_LEVEL=INFO
LOG_JSON=true
WEB_PORT=8000

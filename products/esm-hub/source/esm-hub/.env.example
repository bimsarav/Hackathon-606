# Copy to .env and replace every CHANGE_ME. Never commit .env.
POSTGRES_USER=esm
POSTGRES_PASSWORD=CHANGE_ME_db_password
# Spring profiles for all services: "demo" loads the synthetic Northstar dataset on an EMPTY database; "" for production.
ESM_PROFILES=demo
# RS256 key pair for directory-service: run scripts/gen-jwt-keys.sh >> .env (single-line PEM)
ESM_JWT_PRIVATE_KEY=CHANGE_ME
ESM_JWT_PUBLIC_KEY=CHANGE_ME
ESM_JWT_TTL_MINUTES=60
# Outbound email (notification-service). Default: the local Mailpit sink (UI on http://localhost:8025)
ESM_SMTP_HOST=mailpit
ESM_SMTP_PORT=1025
ESM_MAIL_FROM=esm-hub@example.test
# Published port of the web UI / API
ESM_HTTP_PORT=8080

<mxfile host="app.diagrams.net"><diagram name="aero-recovery-7-priority" id="aero-recovery-7-priority"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="7  Passenger priority logic" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Legal and care duties come first. The weighted score only orders passengers inside a tier. Unaccompanied minors are out of scope (phase 4)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Affected passenger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="160" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Feasible alternative?&lt;br&gt;seats · MCT · same booking" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="250" y="105" width="200" height="100" as="geometry"/></mxCell><mxCell id="c6" value="Next day + hotel + meals&lt;br&gt;(EU261 care if departing the EU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="250" y="270" width="200" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Tier 1: mandated care?&lt;br&gt;WCHR/WCHS/WCHC · BLND · DEAF ·&lt;br&gt;MEDA · PREG · infant in booking" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="260" height="130" as="geometry"/></mxCell><mxCell id="c8" value="Tier 2: urgency?&lt;br&gt;onward connection · last flight&lt;br&gt;of the day · long journey" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="510" y="270" width="260" height="130" as="geometry"/></mxCell><mxCell id="c9" value="Band 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="830" y="130" width="110" height="50" as="geometry"/></mxCell><mxCell id="c10" value="Band 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="830" y="310" width="110" height="50" as="geometry"/></mxCell><mxCell id="c11" value="Band 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="830" y="450" width="110" height="50" as="geometry"/></mxCell><mxCell id="c12" value="Weighted score inside the band:&lt;br&gt;loyalty · frequency · fare ·&lt;br&gt;ancillaries · journey · family/group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="1000" y="230" width="240" height="150" as="geometry"/></mxCell><mxCell id="c13" value="Non-revenue?&lt;br&gt;→ after all revenue passengers" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="1000" y="440" width="240" height="100" as="geometry"/></mxCell><mxCell id="c14" value="Ordered list + reasons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="1025" y="590" width="190" height="50" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;en
<mxfile host="app.diagrams.net"><diagram name="aero-recovery-5-delay" id="aero-recovery-5-delay"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="5  Scenario A: delay" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="An inbound flight is late. The engine propagates the delay along the aircraft, re-checks every connection, builds and costs the options, and the strategy picks the recommendation." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="OCC picks a flight and a delay&lt;br&gt;(or opens it from the 7-day watchlist)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="85" as="geometry"/></mxCell><mxCell id="c5" value="Propagate along the aircraft rotation for 7 days&lt;br&gt;(turn 51 min SHJ, 36 min outstations)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="250" height="85" as="geometry"/></mxCell><mxCell id="c6" value="Re-check every connection&lt;br&gt;(MCT; 15 min – 20 h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="250" height="85" as="geometry"/></mxCell><mxCell id="c7" value="Build options: absorb · same-type swap (≤3) ·&lt;br&gt;cancel a later round trip (≤3) ·&lt;br&gt;consolidate if all fit within 6 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="250" height="85" as="geometry"/></mxCell><mxCell id="c8" value="Cost each option: delay · care · EU261 ·&lt;br&gt;rebooking of passengers left behind" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="250" height="85" as="geometry"/></mxCell><mxCell id="c9" value="Strategy picks the recommendation:&lt;br&gt;lowest cost · protect passengers ·&lt;br&gt;least delay" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="250" height="110" as="geometry"/></mxCell><mxCell id="c10" value="Explain in plain language&lt;br&gt;(Claude or template)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="250" height="85" as="geometry"/></mxCell><mxCell id="c11" value="Person approves, rejects, or&lt;br&gt;overrides with a reason → audit trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="250" height="85" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6368;fontSize=10;fontColor=#1F2124;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6368;fontSize=10;fontColor=#1F2124;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6368;fontSize=10;fontColor=#1F2124;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6368;fontSize=10;fontColor=#1F2124;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6368;fontSize=10;fontColor=#1F2124;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6368;fontSize=10;fontColor=#1F2124;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F6368;fontSize=10;fontColor=#1F2124;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="Also on screen: before/after rotation board · passenger tab (new flight, care, flags, message) · rewards tab (budget)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1000" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
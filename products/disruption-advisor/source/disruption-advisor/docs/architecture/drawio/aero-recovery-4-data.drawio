<mxfile host="app.diagrams.net"><diagram name="aero-recovery-4-data" id="aero-recovery-4-data"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="4  Data pipeline and data model" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="The ingest runs the stages in order and skips work whose inputs and code are unchanged. The API only reads the ops Parquet; PostgreSQL holds what people create plus a copy of the extracts." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Input files (read-only)&lt;/b&gt;&lt;br&gt;Flight Rotation.xls&lt;br&gt;Flight Schedule.csv&lt;br&gt;Flight Inventory.csv&lt;br&gt;Connection Time.xlsx&lt;br&gt;Punctuality Jan–Nov 2026.xlsx&lt;br&gt;Bookings Parquet (name-free, by month)&lt;br&gt;&lt;i&gt;or the original zip&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="250" height="170" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Stage 1 · convert&lt;/b&gt;&lt;br&gt;typed Parquet · names removed&lt;br&gt;bookings by departure month" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F7;strokeColor=#D6002F;dashed=1;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="330" y="145" width="220" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;raw/&lt;/b&gt;&lt;br&gt;rotation · schedule · inventory · mct ·&lt;br&gt;punctuality · bookings (27.9M)" style="sha
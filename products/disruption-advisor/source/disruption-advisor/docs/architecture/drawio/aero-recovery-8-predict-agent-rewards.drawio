<mxfile host="app.diagrams.net"><diagram name="aero-recovery-8-predict-agent-rewards" id="aero-recovery-8-predict-agent-rewards"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="8  Prediction, agent and rewards (phases 2, 3 and 5)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Predictions rank and pre-fill; the agent investigates; rewards stay within a budget. A person decides in every case." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Phase 2 · 7-day watchlist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA0A6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1180" height="170" as="geometry"/></mxCell><mxCell id="c5" value="History Jan – 18 Nov&lt;br&gt;63k flights" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="150" height="80" as="geometry"/></mxCell><mxCell id="c6" value="LightGBM per threshold&lt;br&gt;5 · 15 · 30 · 60 · 120 · 180 min&lt;br&gt;features known 7 days ahead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6EB;strokeColor=#D6002F;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="230" y="115" width="220" height="90" as="geometry"/></mxCell><mxCell id="c7" value="flight risk + TreeSHAP reasons&lt;br&gt;planning delay (20% exceed)" style="rounded=1;white
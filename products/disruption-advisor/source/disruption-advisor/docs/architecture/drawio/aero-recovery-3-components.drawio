<mxfile host="app.diagrams.net"><diagram name="aero-recovery-3-components" id="aero-recovery-3-components"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="3  Components inside the API (modular monolith)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2124;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Entry points start an analysis; the engine computes impact, options, priority and rebooking; the output layer explains and records decisions. Every module is recommend-only." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Entry points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA0A6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="280" height="560" as="geometry"/></mxCell><mxCell id="c5" value="Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA0A6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="690" height="560" as="geometry"/></mxCell><mxCell id="c6" value="Output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA0A6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1050" y="90" width="260" height="560" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;auth&lt;/b&gt;&lt;br&gt;demo roles OCC / PCU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF
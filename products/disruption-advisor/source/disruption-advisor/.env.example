# Copy to .env and fill in. Never commit .env. On a server: chmod 600 .env.
POSTGRES_DB=disruption_advisor
POSTGRES_USER=disruption_advisor
POSTGRES_PASSWORD=change-me-local-only
LOG_LEVEL=INFO
LOG_JSON=true
API_WORKERS=2
WEB_PORT=8080

# Folder holding the airline extracts (Flight Rotation.xls, Flight Inventory.csv, Flight Schedule.csv,
# Connection Time.xlsx, Flight_Punctuality_*.xlsx, "Past & Future Booking Data.zip"). Mounted read-only.
INPUT_DIR=/path/to/extracts
INGEST_MEMORY_LIMIT=4GB
# true = append the labelled synthetic demo scenario (delayed G9901, misconnects, full next flight on SHJ-HBE)
DEMO_SCENARIO=false

# Demo sign-in (two roles): user:password:role entries, comma separated. Use long random passwords.
DEMO_USERS=occ:change-me-occ:OCC,pcu:change-me-pcu:PCU
# Signs the session tokens: a long random value, e.g. `openssl rand -hex 32`.
TOKEN_SECRET=change-me

# Optional: Anthropic API key for AI-written explanations and message drafts (templates are used when empty).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

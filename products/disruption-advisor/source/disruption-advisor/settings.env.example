# Disruption Advisor settings. Copy to settings.env (scripts/init-settings.sh does it) and fill in. Never commit settings.env.
# Docker Compose reads it through the link .env -> settings.env. On a server: chmod 600 settings.env.
POSTGRES_DB=disruption_advisor
POSTGRES_USER=disruption_advisor
POSTGRES_PASSWORD=change-me-local-only
LOG_LEVEL=INFO
LOG_JSON=true
API_WORKERS=2
UI_PORT=8080
API_PORT=8888

# Folder holding the airline extracts (Flight Rotation.xls, Flight Inventory.csv, Flight Schedule.csv,
# Connection Time.xlsx, Flight_Punctuality_*.xlsx, "Past & Future Booking Data.zip"). Mounted read-only.
INPUT_DIR=/path/to/extracts
INGEST_MEMORY_LIMIT=4GB
# true = append the labelled synthetic demo scenario (delayed G9901, misconnects, full next flight on SHJ-HBE)
DEMO_SCENARIO=false
# Carriers in scope (comma separated). Partner/other carriers (3L, 3O, E5, 9P, 4P) are a future enhancement.
OPERATING_CARRIERS=G9

# Demo sign-in: user:password:role entries (roles OCC, PCU, EVALUATOR; only EVALUATOR sees the Model and Test data tabs), comma separated. Use long random passwords.
DEMO_USERS=occ:change-me-occ:OCC,pcu:change-me-pcu:PCU,evaluator:change-me-evaluator:EVALUATOR
# Signs the session tokens: a long random value, e.g. `openssl rand -hex 32`.
TOKEN_SECRET=change-me

# Optional: Anthropic API key for AI-written explanations and message drafts (templates are used when empty).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Phase 3 agent (recommend-only; the rule-based planner answers without a key or when the AI cannot finish)
AGENT_EFFORT=medium
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SECONDS=120

# Airline extracts copied into PostgreSQL schema "extracts" (service extracts-db): all | no-bookings | off.
# "all" includes the 27.9M booking rows (about 6-9 GB of database disk); use no-bookings on small disks.
EXTRACTS_TO_DB=all
